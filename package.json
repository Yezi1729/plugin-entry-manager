{
  "name": "@local/plugin-entry-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Organize DSH sidebar plugin entries into user-defined folders. Entry placement only; never changes plugin enablement.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "scripts",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "sync-locale": "node scripts/sync-locale.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT"
}
